---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 – Page Not Found | Windrose Guides" noIndex={true}>
  <div class="max-w-2xl mx-auto px-4 py-32 text-center">
    <div class="text-8xl mb-6">⚓</div>
    <h1 class="font-display font-800 text-5xl text-white mb-4">Lost at Sea</h1>
    <p class="text-slate-400 text-lg mb-8">
      This page has drifted off the map. Let's get you back to shore.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/" class="btn-primary">Return Home</a>
      <a href="/guides/beginner-guide" class="btn-ghost border border-surface-600">Beginner Guide</a>
    </div>
  </div>
</BaseLayout>
