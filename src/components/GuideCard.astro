---
interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  readTime?: string;
  featured?: boolean;
}

const { title, description, href, category, readTime, featured } = Astro.props;

const categoryColors: Record<string, string> = {
  beginner:    'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  ships:       'bg-blue-500/10 text-blue-400 border-blue-500/20',
  survival:    'bg-amber-500/10 text-amber-400 border-amber-500/20',
  multiplayer: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  settings:    'bg-rose-500/10 text-rose-400 border-rose-500/20',
  resources:   'bg-teal-500/10 text-teal-400 border-teal-500/20',
};

const categoryLabels: Record<string, string> = {
  beginner: 'Beginner',
  ships: 'Ships',
  survival: 'Survival',
  multiplayer: 'Multiplayer',
  settings: 'Settings',
  resources: 'Resources',
};

const colorClass = categoryColors[category] ?? 'bg-slate-500/10 text-slate-400 border-slate-500/20';
const label = categoryLabels[category] ?? category;
---

<a href={href} class={`card group flex flex-col h-full p-5 ${featured ? 'border-brand-500/30' : ''}`}>
  <div class="flex items-start justify-between gap-3 mb-3">
    <span class={`badge border ${colorClass}`}>{label}</span>
    {readTime && <span class="text-slate-600 text-xs">{readTime}</span>}
  </div>
  <h3 class="font-display font-semibold text-white text-base leading-snug mb-2 group-hover:text-brand-400 transition-colors line-clamp-2">
    {title}
  </h3>
  <p class="text-slate-400 text-sm leading-relaxed flex-1 line-clamp-3">
    {description}
  </p>
  <div class="mt-4 flex items-center gap-1.5 text-brand-400 text-xs font-display font-medium">
    Read guide
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="group-hover:translate-x-0.5 transition-transform">
      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</a>
