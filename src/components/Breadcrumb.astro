---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-2 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item" class="text-slate-500 hover:text-brand-400 transition-colors">
        <span itemprop="name">Home</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>
    {crumbs.map((crumb, i) => (
      <li class="flex items-center gap-2" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="text-slate-700">
          <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        {crumb.href ? (
          <a href={crumb.href} itemprop="item" class="text-slate-500 hover:text-brand-400 transition-colors">
            <span itemprop="name">{crumb.label}</span>
          </a>
        ) : (
          <span itemprop="item" class="text-slate-300 font-display font-medium">
            <span itemprop="name">{crumb.label}</span>
          </span>
        )}
        <meta itemprop="position" content={String(i + 2)} />
      </li>
    ))}
  </ol>
</nav>
