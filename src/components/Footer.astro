---
const categories = [
  { href: '/category/beginner', label: 'Beginner Guides' },
  { href: '/category/ships', label: 'Ship Guides' },
  { href: '/category/survival', label: 'Survival Tips' },
  { href: '/category/multiplayer', label: 'Multiplayer' },
  { href: '/category/settings', label: 'Settings & FPS' },
  { href: '/category/resources', label: 'Resources' },
];

const featured = [
  { href: '/guides/beginner-guide', label: 'Beginner Guide' },
  { href: '/guides/best-starter-ship', label: 'Best Starter Ship' },
  { href: '/guides/multiplayer-guide', label: 'Multiplayer Guide' },
  { href: '/guides/fps-boost-guide', label: 'FPS Boost Guide' },
];
---

<footer class="border-t border-surface-700 bg-surface-800 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L19 9L12 11L5 9L12 2Z" fill="white" opacity="0.9"/>
              <path d="M12 11L19 9L22 22L12 18L2 22L5 9L12 11Z" fill="white"/>
            </svg>
          </div>
          <span class="font-display font-bold text-white text-lg">
            Windrose<span class="text-brand-400">Guides</span>
          </span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-xs">
          The most complete Windrose guide hub. Beginner walkthroughs, ship builds, survival strategies, and multiplayer tips.
        </p>
        <p class="text-slate-600 text-xs mt-6">
          WindroseGuides.com is a fan site and is not affiliated with the developers of Windrose.
        </p>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Categories</h3>
        <ul class="space-y-2">
          {categories.map(link => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-brand-400 text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Featured -->
      <div>
        <h3 class="font-display font-semibold text-white text-sm uppercase tracking-wider mb-4">Popular Guides</h3>
        <ul class="space-y-2">
          {featured.map(link => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-brand-400 text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <a href="/about" class="text-slate-500 hover:text-slate-300 text-xs transition-colors mr-4">About</a>
          <a href="/faq" class="text-slate-500 hover:text-slate-300 text-xs transition-colors">FAQ</a>
        </div>
      </div>
    </div>

    <div class="border-t border-surface-700 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-slate-600 text-xs">
        © {new Date().getFullYear()} WindroseGuides.com — All Rights Reserved
      </p>
      <p class="text-slate-600 text-xs">
        Built for the Windrose community ⚓
      </p>
    </div>
  </div>
</footer>
